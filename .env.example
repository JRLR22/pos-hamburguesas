# Copia este archivo como .env y ajusta los valores.
# Genera un secreto propio con: npm run secreto
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Orígenes permitidos para CORS (separados por coma).
# Agrega la IP de la PC en tu red local si usas tablets/celulares.
FRONTEND_URL=http://localhost:5173

PORT=3000

# Imprimir la comanda automáticamente al crear un pedido.
IMPRIMIR_AUTOMATICO=false
# Windows: printer:NombreDeLaImpresora | Linux: /dev/usb/lp0 | Red: tcp://192.168.1.50
PRINTER_INTERFACE=printer:NombreDeLaImpresora

# Solo si corres detrás de un proxy inverso (nginx, etc.)
# TRUST_PROXY=1
